{
  "name": "besnovatyj/yii2-cms-search-manticore",
  "description": "Ядро сквозного поиска на Manticore Search для Yii2 CMS: настоящая лемматизация русского, поиск с опечатками и с ошибочной раскладкой клавиатуры, подсказки «возможно, вы имели в виду». Подключается к фасаду besnovatyj/yii2-cms-search, требует запущенный демон searchd.",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\SearchManticore\\Module",
    "moduleId": "SearchManticore",
    "bescms": {
      "kind": "module"
    },
    "config-plugin": {
      "common": "src/config/common.php"
    }
  },
  "keywords": [
    "yii2",
    "cms",
    "search",
    "manticore",
    "sphinx",
    "fulltext",
    "lemmatization"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "yiisoft/yii2": "~2.0.0",
    "besnovatyj/yii2-cms-contracts": "^1.0",
    "besnovatyj/yii2-cms-helpers": "^1.0",
    "besnovatyj/yii2-cms-kernel": "^1.0",
    "besnovatyj/yii2-cms-search": "^1.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\SearchManticore\\": "src/"
    }
  }
}
